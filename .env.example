# ---------------------------------------------------------------------------
# Gateway
# ---------------------------------------------------------------------------
# Comma separated. When set, every /v1/* call must carry one of these keys as
# `Authorization: Bearer <key>` or `x-api-key: <key>`. /healthz stays open.
# Leave empty only on a trusted private network.
GATEWAY_API_KEY=

# Public port for docker compose.
GATEWAY_PORT=8080

# ---------------------------------------------------------------------------
# Upstream channel
# ---------------------------------------------------------------------------
# en = account.minimax.io  -> agent.minimax.io/mavis/api/v1/llm/v1
# cn = account.minimax.cn  -> agent.minimax.cn/mavis/api/v1/llm/v1
MINIMAX_REGION=en

# Override only if MiniMax renames the endpoint.
MINIMAX_BASE_URL=
MINIMAX_ACCOUNT_BASE=

# Multimodal tools (image / video / speech / music) live under the desktop
# gateway's MCP proxy. Derived from MINIMAX_BASE_URL by swapping /llm/v1 for
# /mcp; set this only if that derivation breaks.
MINIMAX_MCP_BASE=

# Egress proxy. REQUIRED when the host IP gets a 307 to the legacy CN origin
# (mainland networks): the redirect drops Authorization and the legacy origin
# then answers 401 "invalid access token".
# Example: http://192.168.1.10:7890 or socks5://127.0.0.1:1080
UPSTREAM_PROXY=

# Seconds. Long thinking runs can stream for a while.
UPSTREAM_TIMEOUT=600

# Transport for upstream calls.
#   auto (default) - httpx first, switch to curl permanently on a connect error
#   httpx          - always httpx (fastest, connection pooling)
#   curl           - always the curl binary
# Use curl/auto on networks whose egress proxy resets Python's TLS handshake but
# accepts the platform curl (for example accelerators that only allow Windows
# schannel or browser fingerprints).
UPSTREAM_TRANSPORT=auto

# ---------------------------------------------------------------------------
# Credentials (pick one route)
# ---------------------------------------------------------------------------
# Route A - account pool. A directory of one JSON file per account, written by
#   python -m app.provision --file accounts.txt
# Accounts are used round-robin; one that returns 401/402/429 is parked for a
# cool-down instead of failing the whole gateway. Tokens are refreshed in place.
# Uncomment this INSTEAD of the single-token routes below when you have several
# accounts; leaving it empty keeps the single-token behaviour.
# TOKEN_POOL=/data/tokens
# How often the pool directory is re-scanned (seconds). A new account file joins
# the rotation on the next scan; a deleted one leaves it. 0 disables the watcher.
TOKEN_POOL_WATCH=10

# How many accounts the console's "+ add account" import provisions at once.
# The account host rate-limits its login endpoint, so keep this small.
PROVISION_CONCURRENCY=3

# Daily check-in. The reward (400 credits, 1000 on days 4 and 7, valid 30 days,
# spendable in MiniMax Code only) is the only free top-up for a personal
# account. With TOKEN_POOL set the gateway claims it on startup and then every
# SIGNIN_INTERVAL_HOURS; claiming is idempotent, so restarts are harmless.
SIGNIN_AUTO=1
# Must be an IANA name. A raw offset such as 480 is rejected with
# "1406010011 invalid timezone_id".
SIGNIN_TIMEZONE=Asia/Shanghai
SIGNIN_INTERVAL_HOURS=6

# Request history (the console's log/usage pages). Empty path = /data/metrics.db,
# `off` = keep it in memory only (and lose it on every restart).
METRICS_DB=
METRICS_RETENTION_DAYS=3
# Container timezone. The console formats timestamps with SIGNIN_TIMEZONE, but
# `docker compose logs` uses TZ.
TZ=Asia/Shanghai

# Console probes: one read-only GET per account for the sign-in panel and the
# credit ledger, cached for the /ui pages. 0 turns the background sweep off and
# leaves only the manual "刷新探针" button.
PROBE_AUTO=1
PROBE_INTERVAL=300

# Route B - static token copied from a signed-in desktop client. Dies in ~12h.
MINIMAX_ACCESS_TOKEN=
MINIMAX_REFRESH_TOKEN=

# Route C - `python -m app.login` writes this file; the gateway refreshes and
# rewrites it automatically.
TOKEN_STORE=/data/token.json

# Route D - read the desktop client's own credential file (local machine only).
# Defaults to ~/.minimax/auth/prod/<region>/mcode-public/auth.json when unset.
MINIMAX_AUTH_FILE=

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------
DEFAULT_MAX_TOKENS=8192
REQUEST_BODY_LIMIT=67108864
EXPOSE_RETIRED_MODELS=0
LOG_LEVEL=INFO
