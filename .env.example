# ---------------------------------------------------------------------------
# Gateway
# ---------------------------------------------------------------------------
# Comma separated. When set, every /v1/* call must carry one of these keys as
# `Authorization: Bearer <key>` or `x-api-key: <key>`. /healthz stays open.
# Leave empty only on a trusted private network.
GATEWAY_API_KEY=

# Public port for docker compose.
GATEWAY_PORT=8080

# ---------------------------------------------------------------------------
# Upstream channel
# ---------------------------------------------------------------------------
# en = account.minimax.io  -> agent.minimax.io/mavis/api/v1/llm/v1
# cn = account.minimax.cn  -> agent.minimax.cn/mavis/api/v1/llm/v1
MINIMAX_REGION=en

# Override only if MiniMax renames the endpoint.
MINIMAX_BASE_URL=
MINIMAX_ACCOUNT_BASE=

# Egress proxy. REQUIRED when the host IP gets a 307 to the legacy CN origin
# (mainland networks): the redirect drops Authorization and the legacy origin
# then answers 401 "invalid access token".
# Example: http://192.168.1.10:7890 or socks5://127.0.0.1:1080
UPSTREAM_PROXY=

# Seconds. Long thinking runs can stream for a while.
UPSTREAM_TIMEOUT=600

# ---------------------------------------------------------------------------
# Credentials (pick one route)
# ---------------------------------------------------------------------------
# Route A - static token copied from a signed-in desktop client. Dies in ~12h.
MINIMAX_ACCESS_TOKEN=
MINIMAX_REFRESH_TOKEN=

# Route B - `python -m app.login` writes this file; the gateway refreshes and
# rewrites it automatically. This is the recommended server setup.
TOKEN_STORE=/data/token.json

# Route C - read the desktop client's own credential file (local machine only).
# Defaults to ~/.minimax/auth/prod/<region>/mcode-public/auth.json when unset.
MINIMAX_AUTH_FILE=

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------
DEFAULT_MAX_TOKENS=8192
REQUEST_BODY_LIMIT=67108864
EXPOSE_RETIRED_MODELS=0
LOG_LEVEL=INFO
