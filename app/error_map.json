{
  "schema_version": 2,
  "kind": "image",
  "_comment": "Single source of truth for image-generation upstream errors. Rules are INBOUND (raw -> canonical); the canonical table is the OUTBOUND contract. Edit this file, never the if-else in gateway_errors.py.",
  "canonical": {
    "invalid_request_error": {
      "http": 400,
      "type": "invalid_request_error",
      "retry": "never",
      "retry_after_default": null,
      "message": "the request is invalid or unsupported by this model; see the parameter and message"
    },
    "invalid_image": {
      "http": 400,
      "type": "invalid_request_error",
      "retry": "never",
      "retry_after_default": null,
      "message": "the input image could not be used: unsupported format, unreadable data, or a size/mask mismatch"
    },
    "content_policy_violation": {
      "http": 400,
      "type": "invalid_request_error",
      "retry": "never",
      "retry_after_default": null,
      "message": "the prompt or image was rejected by the upstream content policy; changing timing will not help, the request itself must change"
    },
    "request_too_large": {
      "http": 413,
      "type": "invalid_request_error",
      "retry": "never",
      "retry_after_default": null,
      "message": "the request body or the input image exceeds the size limit of this channel"
    },
    "authentication_error": {
      "http": 401,
      "type": "authentication_error",
      "retry": "never",
      "retry_after_default": null,
      "message": "upstream rejected the channel credentials"
    },
    "permission_denied": {
      "http": 403,
      "type": "permission_error",
      "retry": "never",
      "retry_after_default": null,
      "message": "this channel or key is not permitted to use the requested model or feature"
    },
    "model_not_found": {
      "http": 404,
      "type": "invalid_request_error",
      "retry": "never",
      "retry_after_default": null,
      "message": "the requested model does not exist or is not enabled on this channel"
    },
    "task_not_found": {
      "http": 404,
      "type": "invalid_request_error",
      "retry": "never",
      "retry_after_default": null,
      "message": "the image task was not found; the task id is wrong or the task has already expired"
    },
    "rate_limit_exceeded": {
      "http": 429,
      "type": "rate_limit_error",
      "retry": "after_retry_after",
      "retry_after_default": 30,
      "message": "upstream is rate limiting this channel; retry after {retry_after}s"
    },
    "insufficient_quota": {
      "http": 429,
      "type": "insufficient_quota",
      "retry": "never",
      "retry_after_default": null,
      "message": "upstream quota for this channel is exhausted; retrying will not help until the operator tops it up"
    },
    "generation_failed": {
      "http": 502,
      "type": "image_generation_error",
      "retry": "never",
      "retry_after_default": null,
      "message": "the upstream accepted the job but produced no usable image; the generation itself failed"
    },
    "result_unavailable": {
      "http": 502,
      "type": "image_generation_error",
      "retry": "never",
      "retry_after_default": null,
      "message": "the generated image could not be retrieved; the upstream link has expired or is not fetchable"
    },
    "server_is_overloaded": {
      "http": 503,
      "type": "service_unavailable_error",
      "retry": "after_retry_after",
      "retry_after_default": 15,
      "message": "upstream image capacity is exhausted; retry after {retry_after}s"
    },
    "api_error": {
      "http": 500,
      "type": "api_error",
      "retry": "with_backoff",
      "retry_after_default": null,
      "message": "upstream service error; retry with backoff"
    },
    "upstream_timeout": {
      "http": 504,
      "type": "timeout_error",
      "retry": "with_backoff",
      "retry_after_default": null,
      "message": "upstream did not finish the image job in time"
    },
    "unknown_upstream_error": {
      "http": 502,
      "type": "upstream_error",
      "retry": "never",
      "retry_after_default": null,
      "message": "upstream returned an error this gateway could not classify (request_id: {request_id})"
    },
    "partial_success": {
      "http": 200,
      "type": "none",
      "retry": "never",
      "retry_after_default": null,
      "not_an_error": true,
      "message": "some of the requested images were delivered; this is not an error and must not be rendered as one"
    }
  },
